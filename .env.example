# Copy to .env.local and fill in. Never commit a real value.
# Validated at startup by src/lib/env.ts.

# --- Client-safe: bundled and visible in the browser ---
# Where the API is. In development this is the shim (npm run dev:api);
# in production it is the edge-function gateway of your Supabase project.
VITE_API_URL=http://localhost:8787

# --- Development transport only (scripts/dev-api.ts). Never deployed. ---
# The shim connects to Postgres directly and trusts DEV_USER_ID as the signed-in
# user, because there is no auth server in development. Neither is read by the
# edge function, which gets its database from the platform and its user from
# the verified JWT.
DATABASE_URL=postgres://postgres@localhost:5432/dynasty
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_API_PORT=8787

# --- Server-only: edge functions ONLY. Never prefix with VITE_. ---
# A service-role key in a VITE_ variable is shipped to every user of the app.
# SUPABASE_SERVICE_ROLE_KEY=
