# Copy to .env.local and fill in. Never commit a real value.
# Validated at startup by src/lib/env.ts (Prompt 0021).

# --- Client-safe: these are bundled and visible in the browser ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# --- Server-only: edge functions ONLY. Never prefix with VITE_. ---
# A service-role key in a VITE_ variable is shipped to every user of the app.
# SUPABASE_SERVICE_ROLE_KEY=
