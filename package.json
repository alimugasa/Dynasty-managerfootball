{
  "name": "dynasty-manager-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests supabase/functions --ext .ts,.tsx,.js,.mjs --max-warnings 0",
    "lint:arch": "node scripts/lint-arch.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preflight": "npm run typecheck && npm run lint && npm run lint:arch && npm run test",
    "report:sim": "node scripts/sim-report/index.ts",
    "report:drift": "node scripts/drift-report/index.ts",
    "report:sweep": "node scripts/drift-report/sweep.ts",
    "report:market": "node scripts/market-report/index.ts",
    "report:news": "node scripts/news-report/index.ts",
    "perf:fixture": "node scripts/perf/fixture.ts",
    "perf:bench": "node scripts/perf/bench.ts",
    "dev:api": "node scripts/dev-api.ts"
  },
  "dependencies": {
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  }
}
